RED_HANDLE=battleshipred.bsky.social
RED_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BLUE_HANDLE=battleshipblue.bsky.social
BLUE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
LOG_HANDLE=battlelog.bsky.social
LOG_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
DB_PATH=/absolute/path/to/battleship.db
LOG_PATH=/absolute/path/to/battleship.log
TURN_MINUTES=60
# Shots each side fires per turn. The crowd's top SHOTS_PER_TURN
# coordinates are all fired, so a vote that places anywhere in the top
# five still counts.
SHOTS_PER_TURN=5
# 1 = the AI fills any shots the crowd didn't claim; 0 = fire only what
# was actually voted for.
FILL_VOLLEY=1
RESTART_DELAY_SECONDS=3600
